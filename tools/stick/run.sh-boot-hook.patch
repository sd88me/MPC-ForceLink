+# Device-side boot hooks: an installed addin may carry boot.sh (in /data, root only) for what it needs once per
+# boot, e.g. forcelink starting MPC 3.10 + its Force link. The hook decides itself whether to restart MPC.
+for d in "${MPC_ADDINS_DIR:-/data/mpc-addins}"/*/; do
+    [ -f "$d/boot.sh" ] || continue
+    echo "Boot hook: $(basename "${d%/}")"
+    sh "$d/boot.sh" || echo "warning: boot hook $(basename "${d%/}") failed (status $?)"
+done
+
