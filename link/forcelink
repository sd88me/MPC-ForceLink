#!/bin/sh
# Dev box: switch the Force + Live III pair between setups, on both devices, in the right order.
# Two setups:
#   link    the Live III runs MPC 3.10 as itself; the Force is an extra surface for it (its own MPC stopped, flsurf
#           serves its controller to the Live III's ForceLink controller script). The Live III's normal setup: its boot
#           stick brings it up in link every boot.
#   stock   both devices run their own MPC (the Live III: plain 3.9.1, until its next boot).
#   forcelink link | stock      switch both devices
#   forcelink capture   Force stock; Live III on MPC 3.10 with its own controller, controller traffic logged.
#   forcelink status | install    (install also sets the Live III's home setup to link; MAIN + MENU on either device
#                       then toggles only the Force between stock and link)
#   forcelink addins    install the setup-switch addins on both devices (persistent: MPC loads them at every start)
#                       and write switch.conf (fresh token, each side's peer). Then on either device: hold MAIN + MENU
#                       until MENU blinks, press MENU: the Force toggles between stock and link (docs/DEVICE_SWITCH.md).
#   forcelink usb on | off   USB mode: the Live III drives the Force's controller over a USB cable (Live III USB-A to
#                       Force USB-B) instead of Wi-Fi: round trip 0.3 ms instead of 24 ms. Then forcelink link.
#   forcelink cap start | cap stop <name>   record the Force controller's USB traffic (usbmon, Force in stock) while
#                       you use it; stop fetches local/captures/<name>.bin and decodes it (OLEDs, pads, LEDs)
# Hosts come from hosts.conf next to this script (FORCE=<ip>, LIVE3=<ip>); keep it out of any repo.
# Every switch restarts MPC where it changes something, which closes the open project.
set -eu
H=$(cd "$(dirname "$0")" && pwd)
. "$H/hosts.conf"
S="ssh -o BatchMode=yes -o ConnectTimeout=8"
L3=/data/mpc-addins/forcespoof
run() {   # run <host> <cmd>: show the output (minus ssh noise), keep ssh's exit status
    if out=$($S root@"$1" "$2" 2>&1); then rc=0; else rc=$?; fi
    printf '%s\n' "$out" | grep -v hostkeys || true
    return $rc
}
f() { run "$FORCE" "$1"; }
l() { run "$LIVE3" "$1" || { echo "(Live III: no SSH? after a reboot, run the autorun stick first)"; return 1; }; }
case "${1:-status}" in
install)
    f 'mkdir -p /data/forcelink'
    # running binaries can't be overwritten: stage as .new, then mv
    scp -q -o BatchMode=yes "$H/script/flsurf" root@$FORCE:/data/forcelink/flsurf.new
    scp -q -o BatchMode=yes "$H/force/link.sh" "$H/script/handshake.syx" root@$FORCE:/data/forcelink/
    f 'cd /data/forcelink && mv flsurf.new flsurf && chmod +x flsurf link.sh'
    l "mkdir -p $L3/script"
    scp -q -o BatchMode=yes "$H/script/ForceLink.ini" "$H/script/ForceLink.lua" root@$LIVE3:$L3/script/
    scp -q -o BatchMode=yes "$H/script/forcespoof.so" "$H/live3/link.sh" "$H/live3/boot.sh" "$H/script/handshake.syx" root@$LIVE3:/tmp/
    scp -q -o BatchMode=yes "$H/script/flsurf.a64" root@$LIVE3:/tmp/flsurf.new
    l "cd /tmp && mv forcespoof.so link.sh boot.sh handshake.syx $L3/ && mv flsurf.new $L3/flsurf && chmod +x $L3/link.sh $L3/flsurf && echo link > $L3/home.conf && \
       { [ -f $L3/net.conf ] || [ -f $L3/net.conf.off ] || echo $FORCE > $L3/net.conf; }"
    echo "installed (takes effect on the next switch)" ;;
link|b)  f 'sh /data/forcelink/link.sh link' && l "sh $L3/link.sh link" ;;
stock|off) l "sh $L3/link.sh stock" || true; f 'sh /data/forcelink/link.sh stock' ;;
capture) l "sh $L3/link.sh capture" || true; f 'sh /data/forcelink/link.sh stock' ;;
addins)
    tok=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    st=$(mktemp -d)
    for side in live3 force; do
        mkdir -p "$st/$side"
        cp "$H/addin/installer/install.sh" "$H/addin/installer/uninstall.sh" "$H/addin/installer/addin-lib.sh" \
           "$H/addin/$side/addin.manifest" "$H/addin/$side/mpc-plugin.json" "$st/$side/"
    done
    cp "$H/script/forcespoof.so" "$st/live3/"
    cp "$H/../force-link/forcelink-switch.so" "$st/force/"
    printf 'token=%s\npeer=%s\nscript=%s/link.sh\n' "$tok" "$FORCE" "$L3" > "$st/live3/switch.conf"
    printf 'token=%s\npeer=%s\nscript=/data/forcelink/link.sh\n' "$tok" "$LIVE3" > "$st/force/switch.conf"
    scp -q -r -o BatchMode=yes "$st/force" root@$FORCE:/tmp/forcelink-addin
    f "cd /tmp/forcelink-addin && mv switch.conf /data/forcelink/switch.conf && sh install.sh -y -n && rm -rf /tmp/forcelink-addin"
    scp -q -r -o BatchMode=yes "$st/live3" root@$LIVE3:/tmp/forcelink-addin
    l "cd /tmp/forcelink-addin && mv switch.conf $L3/switch.conf && sh install.sh -y -n -t $L3 && rm -rf /tmp/forcelink-addin"
    rm -rf "$st"
    echo "addins installed; they load at MPC's next start (next switch or reboot)" ;;
cap)
    case "${2:-}" in
    start)
        f 'bus=$(for d in /sys/bus/usb/devices/*; do [ -f $d/idProduct ] && [ "$(cat $d/idProduct)" = 0040 ] && cat $d/busnum; done)
           [ -n "$bus" ] || { echo "no Force controller on USB"; exit 1; }
           [ -f /tmp/fl-cap.pid ] && kill $(cat /tmp/fl-cap.pid) 2>/dev/null
           nohup cat /dev/usbmon$bus > /tmp/fl-cap.bin 2>/dev/null & echo $! > /tmp/fl-cap.pid
           echo "recording bus $bus: use the Force now, then: forcelink cap stop <name>"' ;;
    stop)
        n=${3:?usage: forcelink cap stop <name>}
        f 'kill $(cat /tmp/fl-cap.pid) 2>/dev/null; rm -f /tmp/fl-cap.pid; ls -l /tmp/fl-cap.bin'
        mkdir -p "$H/../local/captures"
        scp -q -o BatchMode=yes root@$FORCE:/tmp/fl-cap.bin "$H/../local/captures/$n.bin"
        python3 "$H/../tools/force_capture_render.py" "$H/../local/captures/$n.bin" "$H/../local/captures/$n" ;;
    *) echo "usage: $0 cap start | cap stop <name>"; exit 2 ;;
    esac ;;
usb)
    case "${2:-}" in
    on)  f 'touch /data/forcelink/usb.conf'; l "touch $L3/usb.conf"
         echo "USB mode on: plug a USB-A -> USB-B cable from a Live III USB-A port into the Force's USB-B port, then: forcelink link" ;;
    off) l "rm -f $L3/usb.conf" || true; f 'rm -f /data/forcelink/usb.conf'; echo "USB mode off (Wi-Fi link): forcelink link" ;;
    *) echo "usage: $0 usb on|off"; exit 2 ;;
    esac ;;
status)  echo "== Force"; f 'sh /data/forcelink/link.sh status'; echo "== Live III"; l "sh $L3/link.sh status" ;;
*) echo "usage: $0 link|stock|capture|status|install|addins|usb on|usb off|cap start|cap stop <name>"; exit 2 ;;
esac
