#!/bin/sh
# Dev box: switch the Force + Live III pair between setups, on both devices, in the right order.
#   forcelink stock     both stock (Force: its own MPC; Live III: MPC 3.9.1)
#   forcelink a         version A: Live III runs MPC 3.10 as a Force (Gen 2); the Force is its surface; Live III
#                       controls through the bridge. Modes are shared between the two.
#   forcelink b         version B: Live III stays itself on MPC 3.10; the Force is an extra surface driven by a
#                       controller script (parallel modes). Built offline (b/build.sh), not yet run on the devices.
#   forcelink capture   Force stock; Live III on MPC 3.10 with its own controller, controller traffic logged.
#   forcelink status | install
#   forcelink probe <hex bytes>   send bytes to the Live III controller (version A only), e.g. LED mapping
# Hosts come from hosts.conf next to this script (FORCE=<ip>, LIVE3=<ip>); keep it out of any repo.
# Every switch restarts MPC where it changes something, which closes the open project.
set -eu
H=$(cd "$(dirname "$0")" && pwd)
. "$H/hosts.conf"
S="ssh -o BatchMode=yes -o ConnectTimeout=8"
L3=/data/mpc-addins/forcespoof
run() {   # run <host> <cmd>: show the output (minus ssh noise), keep ssh's exit status
    if out=$($S root@"$1" "$2" 2>&1); then rc=0; else rc=$?; fi
    printf '%s\n' "$out" | grep -v hostkeys || true
    return $rc
}
f() { run "$FORCE" "$1"; }
l() { run "$LIVE3" "$1" || { echo "(Live III: no SSH? after a reboot, run the autorun stick first)"; return 1; }; }
case "${1:-status}" in
install)
    f 'mkdir -p /data/forcelink'
    # running binaries can't be overwritten: stage as .new, then mv
    scp -q -o BatchMode=yes "$H/force/flnet" root@$FORCE:/data/forcelink/flnet.new
    scp -q -o BatchMode=yes "$H/b/flsurf" root@$FORCE:/data/forcelink/flsurf.new
    scp -q -o BatchMode=yes "$H/force/link.sh" "$H/b/handshake.syx" root@$FORCE:/data/forcelink/
    f 'cd /data/forcelink && mv flnet.new flnet && mv flsurf.new flsurf && chmod +x flnet flsurf link.sh'
    l "mkdir -p $L3/b"
    scp -q -o BatchMode=yes "$H/b/ForceLink.ini" "$H/b/ForceLink.lua" root@$LIVE3:$L3/b/
    scp -q -o BatchMode=yes "$H/a/forcespoof.so" "$H/a/live3_init.syx" "$H/live3/link.sh" root@$LIVE3:/tmp/
    l "cd /tmp && mv forcespoof.so live3_init.syx link.sh $L3/ && chmod +x $L3/link.sh && \
       { [ -f $L3/net.conf ] || [ -f $L3/net.conf.off ] || echo $FORCE > $L3/net.conf; }"
    if [ -f "$H/a/map.conf" ]; then scp -q -o BatchMode=yes "$H/a/map.conf" root@$LIVE3:$L3/map.conf; fi
    echo "installed (takes effect on the next switch)" ;;
a|on)    f 'sh /data/forcelink/link.sh a' && l "sh $L3/link.sh a" ;;
b)       f 'sh /data/forcelink/link.sh b' && l "sh $L3/link.sh b" ;;
stock|off) l "sh $L3/link.sh stock" || true; f 'sh /data/forcelink/link.sh stock' ;;
capture) l "sh $L3/link.sh capture" || true; f 'sh /data/forcelink/link.sh stock' ;;
probe)   shift; l "echo 'pub $*' > /tmp/l3probe" ;;
status)  echo "== Force"; f 'sh /data/forcelink/link.sh status'; echo "== Live III"; l "sh $L3/link.sh status" ;;
*) echo "usage: $0 stock|a|b|capture|status|install|probe <hex>"; exit 2 ;;
esac
